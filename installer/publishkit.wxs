<!--
  PublishKit — Windows Installer package (.msi), for IT departments.
  Build (WiX 5):
    wix build installer\publishkit.wxs -ext WixToolset.Util.wixext -arch x64 ^
      -d Version=X.Y.Z -o dist\publishkit.msi

  One package, both audiences (Scope="perUserOrMachine"):
    * double-clicked by someone: installs for them alone, in
      %LOCALAPPDATA%\Programs\PublishKit, with no admin prompt;
    * deployed by IT (Intune, Group Policy, SCCM): for every user, in
      C:\Program Files\PublishKit:
        msiexec /i publishkit.msi ALLUSERS=1 /qn

  Never change the UpgradeCode: it is how Windows and deployment tools know a
  new version replaces the old one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef Version ?>
    <?define Version = "0.1.0" ?>
  <?endif ?>

  <Package Name="PublishKit"
           Manufacturer="Mayorana"
           Version="$(var.Version)"
           UpgradeCode="E1E7A9FB-58E6-41AF-AE59-6E397FDC96D9"
           Scope="perUserOrMachine"
           Compressed="yes">

    <!-- Same version again reinstalls; older is refused, newer replaces. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of PublishKit is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- WebView2 needs Windows 10 version 1809 (build 17763). -->
    <Launch Condition="Installed OR WindowsBuild &gt;= 17763"
            Message="PublishKit needs Windows 10 version 1809 or later." />

    <Icon Id="PublishKitIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PublishKitIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://mayorana.ch/en/apps/publishkit" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Bennekrouf/publishkit/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ── Close the running app ─────────────────────────────────────────────
         Asked to close first, then ended if it hasn't, so the files are never
         in use and no "close these applications" prompt is left stuck. -->
    <util:CloseApplication Id="ClosePublishKit"
                           Target="publishkit.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="1"
                           Timeout="5" />

    <!-- ── Replace an install made with publishkit-setup.exe ─────────────────
         The .exe installer (Inno Setup) uses the same folder. Its uninstaller
         runs silently first, so the two never sit side by side. -->
    <Property Id="INNO_UNINST_USER">
      <RegistrySearch Root="HKCU" Bitness="always64" Type="raw" Name="UninstallString"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{C3A72F1B-8E4D-4B9C-A1F6-D7E5C2B08A34}_is1" />
    </Property>
    <Property Id="INNO_UNINST_MACHINE">
      <RegistrySearch Root="HKLM" Bitness="always64" Type="raw" Name="UninstallString"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{C3A72F1B-8E4D-4B9C-A1F6-D7E5C2B08A34}_is1" />
    </Property>

    <SetProperty Id="RemoveInnoUser" Sequence="execute" Before="RemoveInnoUser"
                 Value="[INNO_UNINST_USER] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
                 Condition="INNO_UNINST_USER AND NOT REMOVE" />
    <CustomAction Id="RemoveInnoUser" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- A machine-wide one needs the installer's own rights to remove. -->
    <SetProperty Id="RemoveInnoMachine" Sequence="execute" Before="RemoveInnoMachine"
                 Value="[INNO_UNINST_MACHINE] /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
                 Condition="INNO_UNINST_MACHINE AND NOT REMOVE AND Privileged" />
    <CustomAction Id="RemoveInnoMachine" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveInnoUser" After="InstallInitialize"
              Condition="INNO_UNINST_USER AND NOT REMOVE" />
      <Custom Action="RemoveInnoMachine" After="RemoveInnoUser"
              Condition="INNO_UNINST_MACHINE AND NOT REMOVE AND Privileged" />
    </InstallExecuteSequence>

    <!-- ── Files ───────────────────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PublishKit">
        <Component Id="App">
          <File Id="PublishKitExe" Source="target\release\publishkit.exe" KeyPath="yes" />
        </Component>
        <Component Id="WebView2Loader">
          <File Source="target\release\WebView2Loader.dll" KeyPath="yes" />
        </Component>
        <Component Id="AppIcon">
          <File Id="IconFile" Source="assets\icon.ico" KeyPath="yes" />
        </Component>
        <Component Id="SetupScript">
          <File Source="scripts\setup-windows.ps1" KeyPath="yes" />
        </Component>
        <Component Id="Readme">
          <File Source="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start menu only: IT decides about desktop shortcuts. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="PublishKitShortcut"
                  Name="PublishKit"
                  Description="Blog and social posts as markdown"
                  Target="[INSTALLFOLDER]publishkit.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PublishKitIcon" />
        <RegistryValue Root="HKMU" Key="Software\Mayorana\PublishKit"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="App" />
      <ComponentRef Id="WebView2Loader" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="SetupScript" />
      <ComponentRef Id="Readme" />
    </Feature>
  </Package>
</Wix>
